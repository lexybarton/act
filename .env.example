# Anthropic API key (or run `ant auth login`)
ANTHROPIC_API_KEY=
# Optional
# CLAUDE_MODEL=claude-opus-5
# PORT=3000
# DATA_DIR=data
# RETENTION_DAYS=30
# MAX_ROUNDS=8
# QUICK_MAX_ROUNDS=3
# Only offer quick mode (hides the full process)
# QUICK_ONLY=1
# Who runs this server; shown in the ground rules, since the operator can read stored data
# OPERATOR=Your name
# "Your turn" pings via ntfy; PUBLIC_URL is the address people open (e.g. your tunnel URL)
# NTFY_URL=https://ntfy.sh
# PUBLIC_URL=https://act.example.com

